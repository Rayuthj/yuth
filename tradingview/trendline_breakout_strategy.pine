// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
strategy("Trendline Breakout Strategy", shorttitle = "TL Breakout", overlay = true, initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 10, commission_type = strategy.commission.percent, commission_value = 0.05, slippage = 1, pyramiding = 0, margin_long = 100, margin_short = 100, max_lines_count = 500, max_bars_back = 2000)

// Rules (defaults picked by research/trendline_backtest.py, see README):
//   Long  : close breaks above a falling resistance trendline (lower highs).
//   Short : close breaks below a rising support trendline (higher lows).
//   Entry : next bar open. Stop: 2 x ATR(14). Target: 3R (3 x the stop distance).
//   Size  : risk a fixed % of equity per trade.
// The trendline engine is the same as in auto_trendlines.pine, on a single pivot level.

// ════════════════════════════════ Inputs ════════════════════════════════
G_TL   = "Trendlines"
G_TRD  = "Entries"
G_EXIT = "Exits"
G_RISK = "Position size"
G_STY  = "Style"

int    pivLen     = input.int(10, "Pivot length", minval = 2, maxval = 50, group = G_TL)
string lineMode   = input.string("Classic only", "Line types", options = ["Classic only", "All slopes"], group = G_TL, tooltip = "Classic only: trade breaks of falling resistance (longs) and rising support (shorts).\nAll slopes: also rising resistance and falling support.")
int    minTouches = input.int(2, "Min touches", minval = 2, maxval = 10, group = G_TL)
int    maxConn    = input.int(3, "Lines per new pivot", minval = 1, maxval = 10, group = G_TL)
int    memory     = input.int(10, "Pivots remembered", minval = 2, maxval = 30, group = G_TL)
int    maxSpan    = input.int(300, "Max bars between anchors", minval = 10, maxval = 1000, group = G_TL)
string validSrc   = input.string("Close", "Line must not be crossed by", options = ["Close", "Wick"], group = G_TL)
float  tolMult    = input.float(0.1, "Touch tolerance (x ATR)", minval = 0, maxval = 2, step = 0.05, group = G_TL)
int    maxAge     = input.int(150, "Stop extending after (bars)", minval = 10, maxval = 1000, group = G_TL)
int    maxActive  = input.int(40, "Active lines per side", minval = 1, maxval = 100, group = G_TL, tooltip = "At most this many resistance lines and this many support lines are watched. The oldest is removed.")
float  breakBuf   = input.float(0.0, "Break buffer (x ATR)", minval = 0, maxval = 3, step = 0.05, group = G_TL)

string tradeDir   = input.string("Both", "Direction", options = ["Both", "Long only", "Short only"], group = G_TRD)
bool   useTrend   = input.bool(false, "Trend filter: only trade with the EMA", inline = "trend", group = G_TRD, tooltip = "Longs only above the EMA, shorts only below it. Helped long-only trading on stocks in the research.")
int    trendLen   = input.int(200, "", minval = 10, maxval = 500, inline = "trend", group = G_TRD)

float  slAtr      = input.float(2.0, "Stop loss (x ATR)", minval = 0.5, maxval = 10, step = 0.25, group = G_EXIT)
string exitMode   = input.string("Fixed target", "Exit", options = ["Fixed target", "ATR trailing stop"], group = G_EXIT)
float  rr         = input.float(3.0, "Target (R multiple)", minval = 0.5, maxval = 10, step = 0.25, group = G_EXIT, tooltip = "Used with 'Fixed target'. 3 = target is 3x the stop distance.")
float  trailAtr   = input.float(3.0, "Trailing stop (x ATR)", minval = 0.5, maxval = 10, step = 0.25, group = G_EXIT, tooltip = "Used with 'ATR trailing stop'. Trails the highest high (longs) / lowest low (shorts) since entry.")

float  riskPct    = input.float(1.0, "Risk per trade (% of equity)", minval = 0.1, maxval = 10, step = 0.1, group = G_RISK)
float  maxPosPct  = input.float(100, "Max position value (% of equity)", minval = 1, maxval = 1000, group = G_RISK, tooltip = "Caps the position size. Above 100% needs leverage: also lower the margin settings in the strategy Properties tab.")

bool   showLines  = input.bool(true, "Show trendlines", group = G_STY)
color  resColor   = input.color(#ef5350, "Resistance", inline = "col", group = G_STY)
color  supColor   = input.color(#26a69a, "Support",    inline = "col", group = G_STY)
int    keepBroken = input.int(5, "Broken lines kept", minval = 0, maxval = 100, group = G_STY)
int    projBars   = 20

// ═════════════════════════════ Trendline engine ═════════════════════════════
type TLine
    int   x1
    float y1
    int   x2
    float slope
    int   touches
    bool  isRes
    line  ln

type Level
    int          len
    int          width
    array<int>   phX
    array<float> phY
    array<int>   plX
    array<float> plY
    array<TLine> active
    array<line>  done

newLevel(int len, int width) =>
    Level.new(len, width, array.new<int>(), array.new<float>(), array.new<int>(), array.new<float>(), array.new<TLine>(), array.new<line>())

lineColor(bool isRes, int transp) =>
    showLines ? color.new(isRes ? resColor : supColor, transp) : na

method valueAt(TLine this, int x) =>
    this.y1 + this.slope * (x - this.x1)

// A broken line is frozen at the break (dashed, faded) and kept in the history list.
// A line that simply got too old is deleted.
method retire(Level this, TLine t, float y, bool broken) =>
    if broken
        t.ln.set_xy2(bar_index, y)
        t.ln.set_color(lineColor(t.isRes, 60))
        t.ln.set_style(line.style_dashed)
        this.done.push(t.ln)
    if not broken
        t.ln.delete()
    if this.done.size() > keepBroken
        line old = this.done.shift()
        old.delete()
    this.done.size()

// Keep at most maxActive active lines of one kind (resistance or support); drop the oldest.
method trim(Level this, bool isRes) =>
    int cnt = 0
    int oldest = -1
    for idx = this.active.size() - 1 to 0
        if this.active.get(idx).isRes == isRes
            cnt += 1
            oldest := idx
    if cnt > maxActive
        TLine o = this.active.remove(oldest)
        o.ln.delete()
    cnt

// Check every active line against this bar: breaks, expiry, extension.
method updateLines(Level this, float atrV) =>
    bool bull = false
    bool bear = false
    float buf = breakBuf * atrV
    int n = this.active.size()
    if n > 0
        for i = n - 1 to 0
            TLine t = this.active.get(i)
            float v = t.valueAt(bar_index)
            bool brokeUp = t.isRes and close > v + buf
            bool brokeDn = not t.isRes and close < v - buf
            bool ended   = brokeUp or brokeDn or bar_index - t.x2 > maxAge
            bull := bull or brokeUp
            bear := bear or brokeDn
            if ended
                this.active.remove(i)
                this.retire(t, v, brokeUp or brokeDn)
            if not ended
                int xe = bar_index + (barstate.islast ? projBars : 0)
                t.ln.set_xy2(xe, t.valueAt(xe))
    [bull, bear]

// Connect a newly confirmed pivot (bar xb, price yb) to earlier pivots of the same kind.
method addPivot(Level this, bool isRes, int xb, float yb, float atrV) =>
    array<int>   xs = isRes ? this.phX : this.plX
    array<float> ys = isRes ? this.phY : this.plY
    float tol = tolMult * atrV
    bool useWick = validSrc == "Wick"
    int made = 0
    int n = xs.size()
    if n > 0
        for j = n - 1 to 0
            int   xa = xs.get(j)
            float ya = ys.get(j)
            if made >= maxConn or xb - xa > maxSpan
                break
            bool classic = isRes ? ya > yb : ya < yb
            if lineMode == "Classic only" and not classic
                continue
            float slope = (yb - ya) / (xb - xa)
            // price must not have closed (or wicked) through the line since its first anchor
            bool valid = true
            for x = xa + 1 to bar_index
                int   off = bar_index - x
                float lv  = ya + slope * (x - xa)
                float px  = isRes ? (useWick ? high[off] : close[off]) : (useWick ? low[off] : close[off])
                if (isRes ? px > lv + tol : px < lv - tol)
                    valid := false
                    break
            if valid
                int touches = 2
                if j < n - 1
                    for k = j + 1 to n - 1
                        if math.abs(ys.get(k) - (ya + slope * (xs.get(k) - xa))) <= tol
                            touches += 1
                if touches >= minTouches
                    int  xe = bar_index + (barstate.islast ? projBars : 0)
                    line ln = line.new(xa, ya, xe, ya + slope * (xe - xa), color = lineColor(isRes, 0), width = this.width, style = classic ? line.style_solid : line.style_dotted)
                    this.active.push(TLine.new(xa, ya, xb, slope, touches, isRes, ln))
                    made += 1
                    this.trim(isRes)
    xs.push(xb)
    ys.push(yb)
    if xs.size() > memory
        xs.shift()
        ys.shift()
    made

// Run the level for the current bar. Called on every bar so history stays consistent.
method onBar(Level this, bool enabled, float ph, float pl, float atrV) =>
    bool bull = false
    bool bear = false
    if enabled and not na(atrV)
        [b, s] = this.updateLines(atrV)
        bull := b
        bear := s
        if not na(ph)
            this.addPivot(true, bar_index - this.len, ph, atrV)
        if not na(pl)
            this.addPivot(false, bar_index - this.len, pl, atrV)
    [bull, bear]

// ════════════════════════════════ Signals ════════════════════════════════
float atrV = ta.atr(14)
float emaV = ta.ema(close, trendLen)
float ph   = ta.pivothigh(high, pivLen, pivLen)
float pl   = ta.pivotlow(low, pivLen, pivLen)

var Level lv = newLevel(pivLen, 2)
[bullBreak, bearBreak] = lv.onBar(true, ph, pl, atrV)

bool longSig  = bullBreak and tradeDir != "Short only" and (not useTrend or close > emaV)
bool shortSig = bearBreak and tradeDir != "Long only" and (not useTrend or close < emaV)

// ════════════════════════════════ Orders ════════════════════════════════
// Size so that hitting the stop loses riskPct of equity, capped by maxPosPct.
positionSize(float dist) =>
    float riskQty = strategy.equity * riskPct / 100 / dist
    float capQty  = strategy.equity * maxPosPct / 100 / close
    math.max(math.min(riskQty, capQty), 0)

var float stopPx  = na
var float tpPx    = na
var float extreme = na

bool  flat      = strategy.position_size == 0
bool  useTarget = exitMode == "Fixed target"
float stopDist  = slAtr * atrV
bool  goLong    = flat and longSig and stopDist > 0
bool  goShort   = flat and shortSig and not goLong and stopDist > 0

if goLong
    stopPx  := close - stopDist
    tpPx    := close + rr * stopDist
    extreme := close
    strategy.entry("Long", strategy.long, qty = positionSize(stopDist))
if goShort
    stopPx  := close + stopDist
    tpPx    := close - rr * stopDist
    extreme := close
    strategy.entry("Short", strategy.short, qty = positionSize(stopDist))

// Trailing stop: ratchet behind the best price since entry (never loosens).
if not useTarget and strategy.position_size > 0
    extreme := math.max(extreme, high)
    stopPx  := math.max(stopPx, extreme - trailAtr * atrV)
if not useTarget and strategy.position_size < 0
    extreme := math.min(extreme, low)
    stopPx  := math.min(stopPx, extreme + trailAtr * atrV)

if goLong or strategy.position_size > 0
    strategy.exit("Long exit", from_entry = "Long", stop = stopPx, limit = useTarget ? tpPx : na)
if goShort or strategy.position_size < 0
    strategy.exit("Short exit", from_entry = "Short", stop = stopPx, limit = useTarget ? tpPx : na)

// ════════════════════════════════ Visuals ════════════════════════════════
bool inTrade = not flat or goLong or goShort
plot(useTrend ? emaV : na, "Trend EMA", color.new(color.gray, 30), 2)
plot(inTrade ? stopPx : na, "Stop", color.new(color.red, 0), 1, plot.style_linebr)
plot(inTrade and useTarget ? tpPx : na, "Target", color.new(color.green, 0), 1, plot.style_linebr)
plotshape(longSig, "Bullish break", shape.triangleup, location.belowbar, supColor, size = size.small)
plotshape(shortSig, "Bearish break", shape.triangledown, location.abovebar, resColor, size = size.small)
