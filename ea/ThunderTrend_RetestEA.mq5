//+------------------------------------------------------------------+
//|                                        ThunderTrend_RetestEA.mq5 |
//|                                           Generated by Gemini AI |
//+------------------------------------------------------------------+
#property copyright "Gemini"
#property link      ""
#property version   "1.01"

#include <Trade\Trade.mqh>

//--- Input Parameters
input group "=== Trading Settings ==="
input double   InpRiskAmount     = 250.0;    // Risk Amount per Trade ($)
input int      InpSwingLookback  = 10;       // Swing High/Low Lookback for SL
input double   InpRiskReward     = 2.0;      // Risk:Reward Ratio (for TP)
input ulong    InpMagicNumber    = 123456;   // EA Magic Number

input group "=== Indicator Settings ==="
input int      InpFastMAPeriod   = 21;       // Fast MA Period (WMA)
input int      InpSlowMAPeriod   = 200;      // Slow MA Period (EMA)

//--- Global Variables
CTrade         trade;
int            handle_wma;
int            handle_ema;
int            setup_state = 0; // 0 = None, 1 = Wait Retest (Buy), -1 = Wait Retest (Sell)
datetime       last_bar_time;

//+------------------------------------------------------------------+
//| Expert initialization function                                   |
//+------------------------------------------------------------------+
int OnInit()
  {
   trade.SetExpertMagicNumber(InpMagicNumber);
   
   handle_wma = iMA(_Symbol, _Period, InpFastMAPeriod, 0, MODE_LWMA, PRICE_CLOSE);
   handle_ema = iMA(_Symbol, _Period, InpSlowMAPeriod, 0, MODE_EMA, PRICE_CLOSE);

   if(handle_wma == INVALID_HANDLE || handle_ema == INVALID_HANDLE)
     {
      Print("Error initializing MA indicators.");
      return(INIT_FAILED);
     }
     
   return(INIT_SUCCEEDED);
  }

//+------------------------------------------------------------------+
//| Expert tick function                                             |
//+------------------------------------------------------------------+
void OnTick()
  {
   // Execute logic once per bar close
   datetime current_time = iTime(_Symbol, _Period, 0);
   if(current_time == last_bar_time) return;
   
   //--- Arrays to store indicator and price data
   double wma[], ema[];
   MqlRates rates[];
   
   ArraySetAsSeries(wma, true);
   ArraySetAsSeries(ema, true);
   ArraySetAsSeries(rates, true);
   
   // Get latest 3 bars
   if(CopyBuffer(handle_wma, 0, 0, 3, wma) <= 0) return;
   if(CopyBuffer(handle_ema, 0, 0, 3, ema) <= 0) return;
   if(CopyRates(_Symbol, _Period, 0, 3, rates) <= 0) return;

   //----------------------------------------------------------------
   // 1. IDENTIFY TREND (Slope of MAs)
   //----------------------------------------------------------------
   bool isDownTrend = (ema[1] < ema[2]) && (wma[1] < wma[2]) && (rates[1].close < ema[1]);
   bool isUpTrend   = (ema[1] > ema[2]) && (wma[1] > wma[2]) && (rates[1].close > ema[1]);

   //----------------------------------------------------------------
   // 2. CHECK FOR BREAKOUT (Setup Creation)
   //----------------------------------------------------------------
   if(isDownTrend && rates[2].close > wma[2] && rates[1].close < wma[1])
     {
      setup_state = -1; // Waiting for retest to SELL
     }
     
   if(isUpTrend && rates[2].close < wma[2] && rates[1].close > wma[1])
     {
      setup_state = 1;  // Waiting for retest to BUY
     }

   // Invalidate setup if price closes on the wrong side
   if(setup_state == -1 && rates[1].close > wma[1]) setup_state = 0; 
   if(setup_state == 1  && rates[1].close < wma[1]) setup_state = 0; 

   //----------------------------------------------------------------
   // 3. CHECK FOR RETEST & EXECUTE TRADE
   //----------------------------------------------------------------
   
   // DOWNTREND RETEST (SELL)
   if(setup_state == -1 && PositionsTotal() == 0)
     {
      if(rates[1].high >= wma[1] && rates[1].close < wma[1])
        {
         double sl = GetHighestHigh(InpSwingLookback);
         double entryPrice = SymbolInfoDouble(_Symbol, SYMBOL_BID);
         
         double risk_distance = sl - entryPrice;
         double tp = entryPrice - (risk_distance * InpRiskReward);
         
         // Calculate lot size dynamically for $250 risk
         double lot_size = CalculateLotSize(entryPrice, sl);
         
         trade.Sell(lot_size, _Symbol, entryPrice, sl, tp, "Downtrend Retest Sell");
         
         setup_state = 0;
         last_bar_time = current_time;
        }
     }

   // UPTREND RETEST (BUY)
   if(setup_state == 1 && PositionsTotal() == 0)
     {
      if(rates[1].low <= wma[1] && rates[1].close > wma[1])
        {
         double sl = GetLowestLow(InpSwingLookback);
         double entryPrice = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
         
         double risk_distance = entryPrice - sl;
         double tp = entryPrice + (risk_distance * InpRiskReward);
         
         // Calculate lot size dynamically for $250 risk
         double lot_size = CalculateLotSize(entryPrice, sl);
         
         trade.Buy(lot_size, _Symbol, entryPrice, sl, tp, "Uptrend Retest Buy");
         
         setup_state = 0;
         last_bar_time = current_time;
        }
     }
  }

//+------------------------------------------------------------------+
//| Custom Position Sizing Function (Dynamic Lot Size)               |
//+------------------------------------------------------------------+
double CalculateLotSize(double entry_price, double sl_price)
  {
   double sl_distance = MathAbs(entry_price - sl_price);
   if(sl_distance == 0) return SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   
   double tick_size  = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   double tick_value = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   
   if(tick_size == 0 || tick_value == 0) return SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   
   // Calculate exact lots based on ticks at risk
   double ticks_at_risk = sl_distance / tick_size;
   double calculated_lot = InpRiskAmount / (ticks_at_risk * tick_value);
   
   // Normalize to broker's volume steps (e.g., 0.01 increments)
   double min_lot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double max_lot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double step_lot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   
   calculated_lot = MathFloor(calculated_lot / step_lot) * step_lot;
   
   // Apply broker constraints
   if(calculated_lot < min_lot) calculated_lot = min_lot;
   if(calculated_lot > max_lot) calculated_lot = max_lot;
   
   // Fix rounding digits based on step lot
   int digits = 2;
   if(step_lot == 0.1) digits = 1;
   if(step_lot == 1.0) digits = 0;
   
   return NormalizeDouble(calculated_lot, digits);
  }

//+------------------------------------------------------------------+
//| Custom Functions for Swing High / Swing Low (Stop Loss)          |
//+------------------------------------------------------------------+
double GetHighestHigh(int lookback)
  {
   double high_arr[];
   ArraySetAsSeries(high_arr, true);
   if(CopyHigh(_Symbol, _Period, 1, lookback, high_arr) > 0)
      return high_arr[ArrayMaximum(high_arr)];
   return 0.0;
  }

double GetLowestLow(int lookback)
  {
   double low_arr[];
   ArraySetAsSeries(low_arr, true);
   if(CopyLow(_Symbol, _Period, 1, lookback, low_arr) > 0)
      return low_arr[ArrayMinimum(low_arr)];
   return 0.0;
  }
