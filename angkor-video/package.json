{
  "name": "angkor-trip-video",
  "version": "1.0.0",
  "description": "A 2-minute 3D cartoon about a group of friends visiting Angkor, rendered with Three.js in headless Chromium",
  "scripts": {
    "music": "node tools/music.js",
    "stills": "node tools/stills.js",
    "render": "node tools/music.js && node tools/render.js --fps 24 --w 1920 --h 1080 --workers 2 --out out/angkor_trip_1080p.mp4"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/moul": "^5.3.0",
    "@fontsource/noto-sans-khmer": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.56.1",
    "three": "^0.169.0"
  }
}